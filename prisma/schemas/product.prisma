model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  code        String
  price       Float
  stock       Int
  sku         String
  type        String
  category    String
  createdAt   DateTime @default(now())
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String
  name2        String
  description String?
  code        String
  createdAt   DateTime @default(now())
}